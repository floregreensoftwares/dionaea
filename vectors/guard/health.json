{
  "description": "The fixed shapes of the app health events: app_error, app_start, screen_load, http_request and web_vital. frame_stats, anr and app_crash are reserved and have no shape yet. The server scrubs messages and templates routes after the guard; those rules are in vectors/health.",
  "schema": "",
  "cases": [
    { "name": "error with every field", "event": "app_error", "props": { "kind": "unhandled", "type": "TypeError", "message": "x is undefined", "frames": "app/cart.js|checkout|42|7|1" }, "expect": { "accepted": { "fields": { "kind": "unhandled", "type": "TypeError", "message": "x is undefined", "frames": "app/cart.js|checkout|42|7|1" }, "undeclared": 0, "invalid": [] } } },
    { "name": "error with the required fields only", "event": "app_error", "props": { "kind": "handled", "type": "java.io.IOException" }, "expect": { "accepted": { "fields": { "kind": "handled", "type": "java.io.IOException" }, "undeclared": 0, "invalid": [] } } },
    { "name": "error kind is required", "event": "app_error", "props": { "type": "TypeError" }, "expect": { "dropped": { "reason": "missing_required_field", "field": "kind" } } },
    { "name": "error kind must be a known one", "event": "app_error", "props": { "kind": "fatal", "type": "TypeError" }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "kind" } } },
    { "name": "error type must be identifier-shaped", "event": "app_error", "props": { "kind": "crash", "type": "has spaces" }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "type" } } },
    { "name": "error with a stack variable is stripped as undeclared", "event": "app_error", "props": { "kind": "crash", "type": "E", "locals": "secret" }, "expect": { "accepted": { "fields": { "kind": "crash", "type": "E" }, "undeclared": 1, "invalid": [] } } },
    { "name": "app start", "event": "app_start", "props": { "start": "cold", "first_frame": 840, "interactive": 1300 }, "expect": { "accepted": { "fields": { "start": "cold", "first_frame": 840, "interactive": 1300 }, "undeclared": 0, "invalid": [] } } },
    { "name": "app start must be cold or warm", "event": "app_start", "props": { "start": "hot", "first_frame": 840 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "start" } } },
    { "name": "app start needs the first frame", "event": "app_start", "props": { "start": "warm" }, "expect": { "dropped": { "reason": "missing_required_field", "field": "first_frame" } } },
    { "name": "app start duration cannot be negative", "event": "app_start", "props": { "start": "warm", "first_frame": -5 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "first_frame" } } },
    { "name": "app start duration is capped at ten minutes", "event": "app_start", "props": { "start": "warm", "first_frame": 600001 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "first_frame" } } },
    { "name": "screen load with an invalid optional field", "event": "screen_load", "props": { "render": 220, "interactive": "soon" }, "expect": { "accepted": { "fields": { "render": 220 }, "undeclared": 0, "invalid": ["interactive"] } } },
    { "name": "network call", "event": "http_request", "props": { "method": "post", "host": "api.example.com", "route": "/v1/orders/:id", "status": 201, "duration": 143, "request_size": 512, "response_size": 2048, "connection": "wifi" }, "expect": { "accepted": { "fields": { "method": "post", "host": "api.example.com", "route": "/v1/orders/:id", "status": 201, "duration": 143, "request_size": 512, "response_size": 2048, "connection": "wifi" }, "undeclared": 0, "invalid": [] } } },
    { "name": "network call to an IPv6 literal host", "event": "http_request", "props": { "method": "get", "host": "[2001:db8::1]:8080", "route": "/x", "status": 200, "duration": 5 }, "expect": { "accepted": { "fields": { "method": "get", "host": "[2001:db8::1]:8080", "route": "/x", "status": 200, "duration": 5 }, "undeclared": 0, "invalid": [] } } },
    { "name": "network call method is lowercase", "event": "http_request", "props": { "method": "POST", "host": "api.example.com", "route": "/", "status": 200, "duration": 1 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "method" } } },
    { "name": "network call status is at most 599", "event": "http_request", "props": { "method": "get", "host": "h", "route": "/", "status": 600, "duration": 1 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "status" } } },
    { "name": "network call has no place for a body", "event": "http_request", "props": { "method": "get", "host": "h", "route": "/", "status": 200, "duration": 1, "body": "{}", "query": "a=1" }, "expect": { "accepted": { "fields": { "method": "get", "host": "h", "route": "/", "status": 200, "duration": 1 }, "undeclared": 2, "invalid": [] } } },
    { "name": "web vital", "event": "web_vital", "props": { "name": "lcp", "value": 2400, "rating": "good", "route": "/home" }, "expect": { "accepted": { "fields": { "name": "lcp", "value": 2400, "rating": "good", "route": "/home" }, "undeclared": 0, "invalid": [] } } },
    { "name": "web vital name is lowercase", "event": "web_vital", "props": { "name": "LCP", "value": 1 }, "expect": { "dropped": { "reason": "invalid_required_field", "field": "name" } } },
    { "name": "web vital rating with an underscore", "event": "web_vital", "props": { "name": "inp", "value": 300, "rating": "needs_improvement" }, "expect": { "accepted": { "fields": { "name": "inp", "value": 300, "rating": "needs_improvement" }, "undeclared": 0, "invalid": [] } } },
    { "name": "events reserved for later have no shape", "event": "frame_stats", "props": {}, "expect": { "dropped": { "reason": "unknown_event" } } }
  ]
}
