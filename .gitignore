# Build output
/target/
/.cargo-target/
**/*.rs.bk
*.pdb

# cargo-mutants
**/mutants.out*/

# Editors and local tool settings
/.idea/
/.vscode/
/.claude/

# Local runtime data
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
.env

# cargo-fuzz output
/fuzz/target/
/fuzz/artifacts/
/fuzz/coverage/
# libFuzzer grows its corpus beside the seeds; only the named seeds are kept
/fuzz/corpus/*/*
!/fuzz/corpus/*/valid.json
!/fuzz/corpus/*/example.toml
