#!/bin/sh
set -eu

message_file=${1:?commit message path is required}
export LC_ALL=C
title=$(sed -n '1p' "$message_file")

sh "$(dirname "$0")/check-message" < "$message_file"

if [ -z "$title" ]; then
    echo "commit subject must not be empty" >&2
    exit 1
fi

case "$title" in
    *[[:space:]])
        echo "commit subject must not end with whitespace" >&2
        exit 1
        ;;
esac

title_length=$(printf '%s' "$title" | wc -c | tr -d '[:space:]')
if [ "$title_length" -gt 72 ]; then
    echo "commit subject must be 72 characters or fewer" >&2
    exit 1
fi

# Scope is intentionally narrower than the usual Conventional Commit grammar:
# it is lowercase and stable enough to use in changelog grouping.
if ! printf '%s\n' "$title" | grep -Eq '^(feat|fix|refactor|perf|test|docs|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: [a-z0-9][^[:cntrl:]]*$'; then
    echo "commit subject must match type(scope): imperative summary" >&2
    echo "scope: lowercase [a-z0-9._-]; allowed types: feat fix refactor perf test docs build ci chore revert" >&2
    exit 1
fi

summary=${title#*: }
case "$summary" in
    *.)
        echo "commit summary must not end with a period" >&2
        exit 1
        ;;
esac

# Bodies are optional. When present, require the conventional blank separator
# and permit only bullets plus indented continuation lines. Comment lines are
# ignored because Git commonly appends them to the message buffer.
if ! awk '
    NR == 1 { next }
    NR == 2 && $0 !~ /^[[:space:]]*$/ && $0 !~ /^[[:space:]]*#/ {
        print "commit body must start after one blank line" > "/dev/stderr"
        bad = 1
        exit 1
    }
    /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
    /^- / || /^[[:space:]]+[^[:space:]]/ { next }
    { print "commit body must contain bullets (- ) or indented continuations" > "/dev/stderr"; bad = 1; exit 1 }
    END { if (bad) exit 1 }
' "$message_file"; then
    exit 1
fi
